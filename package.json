{
  "name": "desk0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "codegen": "flutter_rust_bridge_codegen generate",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "lint": "biome format --write && biome lint --fix && biome check .",
    "deploy:well-known": "cd web/deeplink && wrangler deploy",
    "generate-client": "openapi-generator-cli generate -i ./openapi.json -g typescript-fetch -o ./packages/client --additional-properties=npmName=@workspace/client,supportsES6=true,modelPropertyNaming=camelCase"
  },
  "devDependencies": {
    "@biomejs/biome": "=2.4.15",
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "latest",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "turbo": "^2.10.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "workspaces": [
    "web/*",
    "packages/*",
    "workers/*"
  ],
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "error"
    }
  }
}
